rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function myFamilyId() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.familyId
        : null;
    }

    function sameFamily(familyId) {
      return isSignedIn() && myFamilyId() != null && myFamilyId() == familyId;
    }

    function isFamilyAdmin(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && (
          get(/databases/$(database)/documents/families/$(familyId)).data.adminUid == request.auth.uid
          || get(/databases/$(database)/documents/families/$(familyId)).data.ownerId == request.auth.uid
        );
    }

    function isChipOwner(chipId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/chips/$(chipId))
        && get(/databases/$(database)/documents/chips/$(chipId)).data.chipAuthUid == request.auth.uid;
    }

    // Đăng nhập / hồ sơ — BẮT BUỘC cho Sign In
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        || (
          request.resource.data.familyId is string
          && isFamilyAdmin(request.resource.data.familyId)
          && request.resource.data.keys().hasOnly(['familyId', 'familyCode'])
        );
      allow update: if isOwner(userId)
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['familyId', 'familyCode'])
          && (
            (
              request.resource.data.familyId is string
              && isFamilyAdmin(request.resource.data.familyId)
            )
            || (
              resource.data.familyId is string
              && isFamilyAdmin(resource.data.familyId)
            )
          )
        );
      allow delete: if isOwner(userId);
    }

    // Relay VPS URL + token (đọc sau khi đăng nhập)
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /cameras/{cameraId} {
      allow read: if sameFamily(resource.data.familyId)
        || (
          resource.data.chipId is string
          && isChipOwner(resource.data.chipId)
        );
      allow create: if isSignedIn()
        && request.resource.data.familyId == myFamilyId()
        && isFamilyAdmin(request.resource.data.familyId)
        && request.resource.data.chipId is string
        && get(/databases/$(database)/documents/families/$(request.resource.data.familyId)).data.boundChipId == request.resource.data.chipId;
      allow update: if (
          sameFamily(resource.data.familyId)
          && isFamilyAdmin(resource.data.familyId)
        )
        || (
          resource.data.chipId is string
          && isChipOwner(resource.data.chipId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'runtimeChipId', 'runtimeRelayCameraId', 'lastRuntimeAt'])
        );
      allow delete: if sameFamily(resource.data.familyId)
        && isFamilyAdmin(resource.data.familyId);
    }

    match /alerts/{alertId} {
      allow read: if sameFamily(resource.data.familyId);
      allow create: if isSignedIn()
        && request.resource.data.familyId == myFamilyId();
      allow update: if sameFamily(resource.data.familyId);
    }

    match /families/{familyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && (
          resource.data.adminUid == request.auth.uid
          || resource.data.ownerId == request.auth.uid
        );
    }

    match /family_members/{memberId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /invites/{familyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /family_join_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    match /family_email_invites/{inviteId} {
      allow read, write: if isSignedIn();
    }

    match /family_wifi_join_sessions/{sessionId} {
      allow read, write: if isSignedIn();
    }

    match /chips/{chipId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.chipId == chipId
        && request.resource.data.chipAuthUid == request.auth.uid
        && request.resource.data.keys()
          .hasOnly(['chipId', 'chipAuthUid', 'status', 'lastSeenAt']);
      allow update: if (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['chipId', 'chipAuthUid', 'status', 'lastSeenAt'])
          && resource.data.chipAuthUid == request.auth.uid
          && request.resource.data.chipAuthUid == request.auth.uid
          && request.resource.data.chipId == chipId
        )
        || (
          (
            request.resource.data.familyId is string
            && isFamilyAdmin(request.resource.data.familyId)
          )
          || (
            resource.data.familyId is string
            && isFamilyAdmin(resource.data.familyId)
          )
        );
      allow delete: if false;
    }

    match /sessions/{sessionId} {
      allow read, write: if isSignedIn();
      match /signals/{signalId} {
        allow read, write: if isSignedIn();
      }
    }

    match /webrtc_signals/{signalId} {
      allow read, write: if isSignedIn();
    }
  }
}
